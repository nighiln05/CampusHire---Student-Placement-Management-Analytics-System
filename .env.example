# ==============================================================================
# CampusPlacements - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# DO NOT commit the active .env file containing credentials to source control.

# Flask Application Secret Key (generate a random 32-byte hex key for production)
SECRET_KEY=campus_placements_dev_super_secret_key_change_in_production_2024

# Database Connection URL:
# For Local Testing (Default SQLite zero-config):
# DATABASE_URL=sqlite:///campusplacements.db
#
# For AWS RDS MySQL / Local MySQL:
# Format: mysql+pymysql://<DB_USERNAME>:<DB_PASSWORD>@<RDS_ENDPOINT>:<PORT>/<DB_NAME>
DATABASE_URL=sqlite:///campusplacements.db

# AWS Configuration (Used for S3 file storage)
# When running on EC2 with an attached IAM Role, leave AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY empty, as boto3 will automatically retrieve credentials from IAM.
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Upload Configurations
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
